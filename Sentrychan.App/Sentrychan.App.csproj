<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sentrychan.Core\Sentrychan.Core.csproj" />
    <ProjectReference Include="..\Sentrychan.UI\Sentrychan.UI.csproj" />
  </ItemGroup>

  <!-- Source packs are not part of this repository. A developer who keeps one locally at
       _local\source-pack (git-ignored) gets it built alongside the app and bundled into
       sources/ next to the exe, which seeds the user folder on first run. Its types are
       never compiled in (ReferenceOutputAssembly=false). Without a local pack, or with
       `-p:IncludeSources=false`, the app is built source-less. -->
  <PropertyGroup>
    <SourcePackDir Condition="'$(SourcePackDir)' == ''">$(MSBuildThisFileDirectory)..\_local\source-pack\</SourcePackDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(IncludeSources)' != 'false'">
    <ProjectReference Include="$(SourcePackDir)src\*.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="BundleSourcePack" AfterTargets="Build" Condition="'$(IncludeSources)' != 'false'">
    <ItemGroup>
      <_SourcePackDll Include="$(SourcePackDir)src\bin\$(Configuration)\net9.0\*.Sources.dll" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)sources" />
    <Copy SourceFiles="@(_SourcePackDll)" DestinationFolder="$(OutDir)sources" SkipUnchangedFiles="true"
          Condition="Exists('%(_SourcePackDll.Identity)')" />
  </Target>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="Assets\frpc.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.5" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.0" />
    <PackageReference Include="Refit" Version="7.2.22" />
    <PackageReference Include="Refit.HttpClientFactory" Version="7.2.22" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Sentrychan</Product>
  </PropertyGroup>

</Project>
