<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sentrychan.UI.ViewModels"
             xmlns:controls="using:Sentrychan.UI.Controls"
             x:Class="Sentrychan.UI.Views.LatestArrivalsView"
             x:DataType="vm:LatestArrivalsViewModel"
             x:CompileBindings="False">
  <Grid>
    <DockPanel Margin="24">
        <!-- Header -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,20">
            <StackPanel Grid.Column="0">
                <TextBlock Text="Latest" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Recent releases from your RSS sources" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
            </StackPanel>

            <ComboBox Grid.Column="1" Width="150" Margin="0,0,8,0" VerticalAlignment="Center"
                      ItemsSource="{Binding BatchFilterOptions}" SelectedItem="{Binding SelectedBatchFilter}"
                      ToolTip.Tip="Filter episodes vs batch/complete releases"/>

            <ComboBox Grid.Column="2" Width="200" Margin="0,0,8,0" VerticalAlignment="Center"
                      ItemsSource="{Binding Feeds}" SelectedItem="{Binding SelectedFeed}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Url}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button Grid.Column="3" Content="Refresh" Command="{Binding RefreshCommand}" Classes="ghost" IsEnabled="{Binding !IsLoading}" VerticalAlignment="Center"/>
        </Grid>

        <!-- Loading / Status -->
        <Panel DockPanel.Dock="Top" Margin="0,0,0,16" IsVisible="{Binding IsLoading}">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="100"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Panel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" 
                   HorizontalAlignment="Center" Margin="0,20,0,0" IsVisible="{Binding !IsLoading}"/>

        <!-- Anime Grid -->
        <!-- Pager — only shown when the feeds returned more than one page.
             Each page resolves its own posters, so paging never stacks API work. -->
        <Border DockPanel.Dock="Bottom" IsVisible="{Binding HasPages}"
                Padding="0,12,0,4"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                <Button Content="Previous" Classes="ghost" MinWidth="96"
                        Command="{Binding PrevPageCommand}"
                        IsEnabled="{Binding CanPrevPage}"/>
                <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center"
                           FontSize="12" FontWeight="600"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Button Content="Next" Classes="accent" MinWidth="96"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanNextPage}"/>
            </StackPanel>
        </Border>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding AnimeList}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SeasonalAnimeVm">
                        <Border Width="184" Margin="10" Background="{DynamicResource CardBackgroundBrush}"
                                CornerRadius="8" BoxShadow="0 4 10 0 #40000000">
                            <StackPanel>
                                <Border Height="252" CornerRadius="8,8,0,0" ClipToBounds="True">
                                    <Panel>
                                        <!-- Placeholder behind the poster: shows through when no
                                             thumbnail could be resolved (most JAV releases have no cover) -->
                                        <Panel Background="{DynamicResource SurfaceBackgroundBrush}">
                                            <Image Source="avares://Sentrychan.UI/Assets/logo.png"
                                                   Width="64" Height="64" Opacity="0.18"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Panel>
                                        <controls:AsyncImage Url="{Binding Anime.LargeImageUrl}" Stretch="UniformToFill"
                                                             Cursor="Hand" Tapped="OnPosterTapped"/>
                                        <Border CornerRadius="12" Background="#00C853" Margin="8" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding IsInLibrary}">
                                            <Path Data="M3 8l3 3 6-6" Stroke="White" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Background="#A0000000" VerticalAlignment="Bottom" Padding="6,4">
                                            <TextBlock Text="{Binding Anime.Status}" Foreground="White" FontSize="11" TextAlignment="Center"/>
                                        </Border>
                                    </Panel>
                                </Border>
                                <Border Padding="12,10,12,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Anime.DisplayTitle}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Height="40" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0">
                                            <Button Grid.Column="0" Content="Details" Classes="ghost" Command="{Binding OpenDetailsCommand}" Padding="8,4" FontSize="12"/>
                                            <Button Grid.Column="1" Classes="accent" Command="{Binding DownloadCommand}" Width="32" Height="32" Padding="0" Margin="0,0,6,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Download this release" IsVisible="{Binding HasDownload}">
                                                <PathIcon Data="{StaticResource DownloadRegular}" Width="14" Height="14"/>
                                            </Button>
                                            <Button Grid.Column="2" Content="+" Classes="accent" Command="{Binding AddToLibraryCommand}" Width="32" Height="32" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Add to library" IsVisible="{Binding !IsInLibrary}"/>
                                            <ProgressBar Grid.Column="2" IsIndeterminate="True" Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding IsAdding}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>

    <!-- Poster lightbox — click a thumbnail to view it enlarged; click anywhere to close -->
    <Border IsVisible="{Binding HasPreview}" ZIndex="900"
            Background="#DD000000" Tapped="OnClosePreview">
        <Grid RowDefinitions="*,Auto" Margin="40">
            <controls:AsyncImage Grid.Row="0" Url="{Binding PreviewImageUrl}"
                                 Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Text="Click anywhere to close" HorizontalAlignment="Center"
                       Margin="0,14,0,0" FontSize="12" Foreground="#CCFFFFFF"/>
        </Grid>
    </Border>
  </Grid>
</UserControl>
