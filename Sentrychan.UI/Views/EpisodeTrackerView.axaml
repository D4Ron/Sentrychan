<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sentrychan.UI.ViewModels"
             xmlns:controls="using:Sentrychan.UI.Controls"
             x:Class="Sentrychan.UI.Views.EpisodeTrackerView"
             x:DataType="vm:EpisodeTrackerViewModel">
    <DockPanel Margin="24">
        <!-- Header -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <StackPanel Grid.Column="0">
                <TextBlock Text="Episode Tracker" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Overview of series status and missing episodes" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Classes="ghost"/>
        </Grid>

        <!-- Grid -->
        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="1">
            <DataGrid ItemsSource="{Binding TrackerItems}"
                      AutoGenerateColumns="False"
                      Background="Transparent"
                      CanUserResizeColumns="True"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Series" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:TrackerItem">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,4">
                                    <Border CornerRadius="2" ClipToBounds="True" Width="30" Height="42">
                                        <controls:AsyncImage Url="{Binding Series.PosterPath}" Stretch="UniformToFill"/>
                                    </Border>
                                    <TextBlock Text="{Binding Series.Title}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTextColumn Header="Local" Binding="{Binding LocalCount}" Width="80"/>
                    <DataGridTextColumn Header="Latest Aired" Binding="{Binding LatestAired}" Width="100"/>
                    
                    <DataGridTemplateColumn Header="Status" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:TrackerItem">
                                <TextBlock Text="{Binding StatusText}" 
                                           Foreground="{Binding StatusColor, Converter={StaticResource StringToBrushConverter}}" 
                                           VerticalAlignment="Center" 
                                           Margin="12,0" 
                                           FontSize="12" 
                                           FontWeight="Bold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTemplateColumn Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:TrackerItem">
                                <Button Content="Search" Classes="ghost" IsVisible="{Binding IsMissing}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
