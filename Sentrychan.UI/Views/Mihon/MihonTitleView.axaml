<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sentrychan.UI.ViewModels"
             xmlns:mihon="using:Sentrychan.UI.ViewModels.Mihon"
             xmlns:controls="using:Sentrychan.UI.Controls"
             x:Class="Sentrychan.UI.Views.Mihon.MihonTitleView"
             x:DataType="vm:MangaDetailViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24,18,24,12">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
            <Border Width="132" Height="190" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource SurfaceBackgroundBrush}">
                <controls:AsyncImage Url="{Binding CoverUrl}" SourceName="{Binding Manga.Source}" Stretch="UniformToFill"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="18,0,0,0" Spacing="7">
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding StatusLine}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="5" Padding="9,4" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding ProgressText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentLightBrush}"/>
                </Border>
                <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <WrapPanel Margin="0,2,0,0">
                    <Button Classes="ghost" Content="‹ Back" Command="{Binding BackCommand}" Margin="0,0,6,6"/>
                    <Button Classes="accent" Content="{Binding ContinueLabel}" Command="{Binding ContinueCommand}"
                            IsEnabled="{Binding CanContinue}" Margin="0,0,6,6"/>
                    <Button Classes="ghost" Content="Download ▾" IsVisible="{Binding !IsNovel}" Margin="0,0,6,6">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Next chapter" Command="{Binding DownloadNextCommand}" CommandParameter="1"/>
                                <MenuItem Header="Next 5 chapters" Command="{Binding DownloadNextCommand}" CommandParameter="5"/>
                                <MenuItem Header="Next 10 chapters" Command="{Binding DownloadNextCommand}" CommandParameter="10"/>
                                <MenuItem Header="Unread" Command="{Binding DownloadNextCommand}" CommandParameter="unread"/>
                                <MenuItem Header="All" Command="{Binding DownloadNextCommand}" CommandParameter="all"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="ghost" Content="Categories…" Click="OnSetCategories" IsVisible="{Binding HasLibraryFeatures}" Margin="0,0,6,6"/>
                    <Button Classes="ghost" Content="Migrate…" Click="OnMigrate" IsVisible="{Binding HasLibraryFeatures}" Margin="0,0,6,6"/>
                    <Button Classes="ghost" Content="Mark all read" Command="{Binding MarkAllReadCommand}" Margin="0,0,6,6"/>
                    <Button Classes="ghost" Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,6,6"/>
                </WrapPanel>
            </StackPanel>
        </Grid>

        <!-- Chapter toolbar: filters, sort, download summary -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6" Margin="0,0,0,6">
            <Button Classes="ghost" ToolTip.Tip="Filter chapters">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Filter"/>
                    <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource AccentBrush}"
                            IsVisible="{Binding ChapterFiltersActive}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Spacing="4" MinWidth="200">
                            <TextBlock Text="Click to cycle: include ✓ · exclude ✕ · any" FontSize="11"
                                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                            <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Command="{Binding CycleChapterFilterCommand}" CommandParameter="Unread">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding UnreadFilterGlyph}" Width="14" FontWeight="Bold"/>
                                    <TextBlock Text="Unread"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Command="{Binding CycleChapterFilterCommand}" CommandParameter="Downloaded">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding DownloadedFilterGlyph}" Width="14" FontWeight="Bold"/>
                                    <TextBlock Text="Downloaded"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Command="{Binding CycleChapterFilterCommand}" CommandParameter="Bookmarked">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding BookmarkedFilterGlyph}" Width="14" FontWeight="Bold"/>
                                    <TextBlock Text="Bookmarked"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button Grid.Column="1" Classes="ghost" Content="{Binding ChapterSortLabel}" ToolTip.Tip="Sort — pick again to flip">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="Source order" Command="{Binding SetChapterSortCommand}" CommandParameter="SourceOrder"/>
                        <MenuItem Header="Chapter number" Command="{Binding SetChapterSortCommand}" CommandParameter="Number"/>
                        <MenuItem Header="Upload date" Command="{Binding SetChapterSortCommand}" CommandParameter="UploadDate"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" Margin="8,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding DownloadSummary}" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                <Button Classes="ghost" Content="Retry failed" IsVisible="{Binding HasFailed}" Command="{Binding RetryFailedCommand}"/>
                <Button Classes="ghost" Content="Cancel downloads" IsVisible="{Binding IsDownloadActive}" Command="{Binding CancelAllDownloadsCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Selection bar -->
        <Border Grid.Row="2" IsVisible="{Binding InChapterSelection}" Background="{DynamicResource AccentSubtleBrush}"
                CornerRadius="8" Padding="12,6" Margin="0,0,0,6">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="{Binding ChapterSelectionText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Button Classes="ghost" Content="All" Command="{Binding SelectAllCommand}" Margin="0,0,4,0"/>
                    <Button Classes="ghost" Content="Range" ToolTip.Tip="Fill in everything between the first and last ticked"
                            Command="{Binding SelectRangeCommand}" Margin="0,0,4,0"/>
                    <Button Classes="ghost" Content="Invert" Command="{Binding InvertSelectionCommand}" Margin="0,0,10,0"/>
                    <Button Classes="ghost" Content="Download" Command="{Binding DownloadSelectedCommand}" IsVisible="{Binding !IsNovel}" Margin="0,0,4,0"/>
                    <Button Classes="ghost" Content="Mark read" Command="{Binding MarkSelectedReadCommand}" Margin="0,0,4,0"/>
                    <Button Classes="ghost" Content="Mark unread" Command="{Binding MarkSelectedUnreadCommand}" Margin="0,0,4,0"/>
                    <Button Classes="ghost" Content="Bookmark" Command="{Binding BookmarkSelectedCommand}" Margin="0,0,4,0"/>
                    <Button Classes="ghost" Content="Unbookmark" Command="{Binding UnbookmarkSelectedCommand}" Margin="0,0,4,0"/>
                    <Button Classes="ghost" Content="Delete downloads" Command="{Binding DeleteSelectedDownloadsCommand}"
                            IsVisible="{Binding !IsNovel}" Margin="0,0,4,0"/>
                    <Button Classes="ghost" Content="✕" ToolTip.Tip="Clear selection" Command="{Binding SelectNoneCommand}"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Chapters: a virtualising list, since long series run to hundreds -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8">
            <ListBox ItemsSource="{Binding VisibleChapters}" Background="Transparent" SelectionMode="Single">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:MangaChapterVm">
                        <Border Padding="10,7" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Read" Command="{Binding ReadCommand}"/>
                                    <MenuItem Header="Mark previous as read"
                                              Command="{Binding $parent[UserControl].((vm:MangaDetailViewModel)DataContext).MarkPreviousReadCommand}"
                                              CommandParameter="{Binding}"/>
                                    <MenuItem Header="Bookmark / remove bookmark"
                                              Command="{Binding $parent[UserControl].((vm:MangaDetailViewModel)DataContext).ToggleBookmarkCommand}"
                                              CommandParameter="{Binding}"/>
                                    <MenuItem Header="Download" Command="{Binding DownloadCommand}" IsVisible="{Binding ShowDownloadButton}"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Grid.Column="1" Text="🔖" IsVisible="{Binding IsBookmarked}" VerticalAlignment="Center"
                                           Margin="0,0,6,0" FontSize="12"/>
                                <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="0"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding ReadCommand}"
                                        Opacity="{Binding IsRead, Converter={x:Static mihon:ReadOpacity.Instance}}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Heading}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding SubLine}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                            IsVisible="{Binding CanDownload}">
                                    <Button Classes="ghost" FontSize="11" Padding="9,3" Content="↓" ToolTip.Tip="{Binding DownloadTip}"
                                            IsVisible="{Binding ShowDownloadButton}" Command="{Binding DownloadCommand}"/>
                                    <Border Classes="chip" IsVisible="{Binding IsQueued}"><TextBlock Text="Queued"/></Border>
                                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsDownloading}">
                                        <ProgressBar Width="70" Height="5" MinWidth="0" Minimum="0" Maximum="100" Value="{Binding Progress}"
                                                     IsIndeterminate="{Binding !IsProgressKnown}" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="{Binding ProgressText}" FontSize="10.5" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button Classes="ghost" FontSize="11" Padding="7,3" Content="✕" IsVisible="{Binding IsBusy}"
                                            Command="{Binding CancelDownloadCommand}"/>
                                    <Border Classes="chip good" IsVisible="{Binding IsDownloaded}" ToolTip.Tip="{Binding DoneLabel}">
                                        <TextBlock Text="✓"/>
                                    </Border>
                                    <Border Classes="chip bad" IsVisible="{Binding IsFailed}" ToolTip.Tip="{Binding ErrorText}">
                                        <TextBlock Text="Failed"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
