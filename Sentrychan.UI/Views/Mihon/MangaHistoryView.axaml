<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mihon="using:Sentrychan.UI.ViewModels.Mihon"
             xmlns:controls="using:Sentrychan.UI.Controls"
             x:Class="Sentrychan.UI.Views.Mihon.MangaHistoryView"
             x:DataType="mihon:MangaHistoryViewModel">

    <DockPanel Margin="0,12,0,0">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,0,0,10">
            <Button Classes="ghost" Command="{Binding ClearCommand}" Foreground="{DynamicResource StatusRedBrush}">
                <Panel>
                    <TextBlock Text="Clear history" IsVisible="{Binding !ConfirmingClear}"/>
                    <TextBlock Text="Clear all history?" IsVisible="{Binding ConfirmingClear}"/>
                </Panel>
            </Button>
        </StackPanel>

        <Panel>
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="mihon:HistoryRowVm">
                            <Border Padding="8,6" CornerRadius="6" Margin="0,0,0,2" Background="{DynamicResource CardBackgroundBrush}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Button Padding="0" Background="Transparent" BorderThickness="0"
                                            Command="{Binding OpenTitleCommand}" ToolTip.Tip="Open title">
                                        <Border Width="46" Height="64" CornerRadius="4" ClipToBounds="True"
                                                Background="{DynamicResource SurfaceBackgroundBrush}">
                                            <controls:AsyncImage Url="{Binding CoverPath}" SourceName="{Binding Source}" Stretch="UniformToFill"/>
                                        </Border>
                                    </Button>
                                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Classes="accent" FontSize="11.5" Padding="12,5" Content="Resume" Command="{Binding ResumeCommand}"/>
                                        <Button Classes="ghost" FontSize="11.5" Padding="8,5" Content="✕" ToolTip.Tip="Remove from history"
                                                Command="{Binding RemoveCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextTertiaryBrush}" Text="Nothing read yet."/>
        </Panel>
    </DockPanel>
</UserControl>
