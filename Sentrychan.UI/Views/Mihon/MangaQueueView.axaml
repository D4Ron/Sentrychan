<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mihon="using:Sentrychan.UI.ViewModels.Mihon"
             x:Class="Sentrychan.UI.Views.Mihon.MangaQueueView"
             x:DataType="mihon:MangaQueueViewModel">

    <DockPanel Margin="0,12,0,0">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Classes="accent" Content="{Binding PauseText}" Command="{Binding TogglePauseCommand}" IsEnabled="{Binding !IsEmpty}"/>
                <Button Classes="ghost" Command="{Binding CancelAllCommand}" IsEnabled="{Binding !IsEmpty}"
                        Foreground="{DynamicResource StatusRedBrush}">
                    <Panel>
                        <TextBlock Text="Cancel all" IsVisible="{Binding !ConfirmingCancel}"/>
                        <TextBlock Text="Cancel every download?" IsVisible="{Binding ConfirmingCancel}"/>
                    </Panel>
                </Button>
            </StackPanel>
        </Grid>

        <Panel>
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="mihon:QueueRowVm">
                            <Border Padding="12,8" CornerRadius="6" Margin="0,0,0,2" Background="{DynamicResource CardBackgroundBrush}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding Chapter}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding State}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                        <ProgressBar Minimum="0" Maximum="100" Height="4" MinHeight="0" CornerRadius="2" MaxWidth="420"
                                                     HorizontalAlignment="Left" Width="420"
                                                     IsVisible="{Binding IsRunning}" Value="{Binding Progress}"
                                                     IsIndeterminate="{Binding !IsProgressKnown}"
                                                     Foreground="{DynamicResource AccentBrush}"
                                                     Background="{DynamicResource SurfaceBackgroundBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Classes="ghost" Content="⤒" ToolTip.Tip="Download next" Command="{Binding MoveToTopCommand}"
                                                IsVisible="{Binding !IsRunning}"/>
                                        <Button Classes="ghost" Content="↑" ToolTip.Tip="Move up" Command="{Binding MoveUpCommand}"
                                                IsVisible="{Binding !IsRunning}"/>
                                        <Button Classes="ghost" Content="↓" ToolTip.Tip="Move down" Command="{Binding MoveDownCommand}"
                                                IsVisible="{Binding !IsRunning}"/>
                                        <Button Classes="ghost" Content="✕" ToolTip.Tip="Cancel — pages already saved are kept"
                                                Command="{Binding CancelCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextTertiaryBrush}" Text="No chapters are downloading."/>
        </Panel>
    </DockPanel>
</UserControl>
