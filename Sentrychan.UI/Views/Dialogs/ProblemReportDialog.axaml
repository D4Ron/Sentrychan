<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sentrychan.UI.Views.Dialogs.ProblemReportDialog"
        Title="Problem report"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <StackPanel Margin="24,20" Spacing="12">
        <TextBlock x:Name="Heading" Text="Send a problem report" FontSize="19" FontWeight="Bold"/>
        <TextBlock x:Name="Intro" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="This makes one file with what the developer needs to see what went wrong: the app's logs, your folders and whether they can be written to, your series and recent downloads, your settings (passwords and keys left out) and pictures of the open windows. Nothing is sent anywhere — you send the file yourself."/>
        <StackPanel x:Name="AskPanel" Spacing="6">
            <TextBlock Text="What happened? (optional)" FontSize="12.5" FontWeight="SemiBold"/>
            <TextBox x:Name="WhatHappened" AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                     Watermark="e.g. I deleted a show's folder and it didn't come back"/>
        </StackPanel>
        <ProgressBar x:Name="Busy" IsIndeterminate="True" IsVisible="False" Height="3"/>
        <SelectableTextBlock x:Name="Result" TextWrapping="Wrap" FontSize="12.5" IsVisible="False"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="ShowFileButton" Content="Show the file" Classes="accent" IsVisible="False" Click="OnShowFile"/>
            <Button x:Name="CreateButton" Content="Create report" Classes="accent" Click="OnCreate"/>
            <Button x:Name="CloseButton" Content="Close" Classes="ghost" Click="OnClose"/>
        </StackPanel>
    </StackPanel>
</Window>
