<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sentrychan.UI.ViewModels"
        xmlns:ctl="using:Sentrychan.UI.Controls"
        x:Class="Sentrychan.UI.Views.Dialogs.SourcesCheckDialog"
        x:DataType="vm:SourcesCheckViewModel"
        Title="Your sources"
        Width="700" Height="560" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="24,20">
        <StackPanel Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="Your sources" FontSize="19" FontWeight="Bold"/>
            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"
                       Text="What Sentrychan has to find episodes and manga with, and whether each one works."/>
        </StackPanel>
        <ScrollViewer Grid.Row="1">
            <ctl:SourcesCheckView Margin="0,0,10,0"/>
        </ScrollViewer>
        <Button Grid.Row="2" Content="Done" Classes="accent" HorizontalAlignment="Right" Margin="0,14,0,0"
                Click="OnDone"/>
    </Grid>
</Window>
