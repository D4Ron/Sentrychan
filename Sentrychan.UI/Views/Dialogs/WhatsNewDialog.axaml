<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:upd="using:Sentrychan.Core.Updates"
        xmlns:dlg="using:Sentrychan.UI.Views.Dialogs"
        x:Class="Sentrychan.UI.Views.Dialogs.WhatsNewDialog"
        x:DataType="dlg:WhatsNewDialog"
        Title="What's new"
        Width="620" Height="600" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid RowDefinitions="Auto,*,Auto" Margin="26,22">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,14">
            <TextBlock Text="What's new" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="{Binding Subtitle}" FontSize="12.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Entries}" Margin="0,0,14,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="upd:ChangelogEntry">
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="18,14" Margin="0,0,0,12">
                            <StackPanel Spacing="8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding DateText}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Changes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid ColumnDefinitions="16,*" Margin="0,2">
                                                <TextBlock Text="•" FontSize="13" Foreground="{DynamicResource AccentLightBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Got it" Classes="accent" HorizontalAlignment="Right" Margin="0,12,0,0"
                Padding="22,8" Click="OnClose" IsDefault="True"/>
    </Grid>
</Window>
