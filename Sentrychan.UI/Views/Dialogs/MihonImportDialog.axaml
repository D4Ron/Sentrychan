<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sentrychan.UI.ViewModels"
        x:Class="Sentrychan.UI.Views.Dialogs.MihonImportDialog"
        x:DataType="vm:MihonImportViewModel"
        Title="Import Mihon backup"
        Width="760" Height="600" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="22">
        <StackPanel Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="Import Mihon backup" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="{Binding FileName}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"/>
            <TextBlock Text="{Binding Summary}" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0"
                       IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Details}" Margin="0,0,0,10">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- What couldn't be placed, and why -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*" IsVisible="{Binding HasUnmatched}">
            <TextBlock Text="{Binding MissingSources}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,6"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ListBox Grid.Row="1" ItemsSource="{Binding Unmatched}" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:MihonImportViewModel+UnmatchedRow">
                        <StackPanel Spacing="1" Margin="0,2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding Source}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Reason}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="80" Height="4" IsVisible="{Binding IsBusy}"/>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="13" MaxWidth="440"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Stop" Classes="ghost pill" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}"/>
                <Button Content="Import" Classes="accent pill" Command="{Binding ImportCommand}" IsVisible="{Binding !IsDone}"/>
                <Button Content="Close" Classes="ghost pill" Click="OnClose"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
