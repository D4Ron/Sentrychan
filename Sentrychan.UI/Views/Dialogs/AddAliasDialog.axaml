<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sentrychan.UI.Views.Dialogs.AddAliasDialog"
        Title="Add Title Alias"
        Width="400" Height="200"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        CornerRadius="{DynamicResource DialogCornerRadius}"
        CanResize="False">
    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <TextBlock Grid.Row="0" Text="Enter alternative title for RSS matching:" 
                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>
        
        <TextBox Grid.Row="1" Name="AliasTextBox" Watermark="e.g. Frieren: Beyond Journey's End" 
                 VerticalAlignment="Top" Height="36"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
            <Button Content="Cancel" Name="CancelButton" Classes="ghost"/>
            <Button Content="Add Alias" Name="AddButton" Classes="accent" Width="100"/>
        </StackPanel>
    </Grid>
</Window>
