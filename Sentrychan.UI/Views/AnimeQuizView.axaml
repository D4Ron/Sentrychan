<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sentrychan.UI.ViewModels"
             xmlns:controls="using:Sentrychan.UI.Controls"
             xmlns:converters="using:Sentrychan.UI.Converters"
             x:Class="Sentrychan.UI.Views.AnimeQuizView"
             x:DataType="vm:AnimeQuizViewModel"
             x:CompileBindings="False"
             Focusable="True">
    <UserControl.Styles>
        <Style Selector="Button.opt">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="600"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.opt.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
        </Style>
        <Style Selector="Button.opt.correct">
            <Setter Property="Background" Value="#2E7D32"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2E7D32"/>
        </Style>
        <Style Selector="Button.opt.wrong">
            <Setter Property="Background" Value="#C62828"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#C62828"/>
        </Style>
        <Style Selector="Button.count">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20,11"/><Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="600"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.seg">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,8"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="600"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.seg.active">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </UserControl.Styles>

    <Panel Margin="24">

        <!-- ============ SETUP ============ -->
        <ScrollViewer IsVisible="{Binding IsSetup}" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="🎬  Anime Quiz" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Hear an opening, guess the anime before the timer runs out — you can change your pick until time's up, then the answer replays as video."/>

            <TextBlock Text="Difficulty  (how well-known the anime is)" FontSize="13" FontWeight="600"
                       HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{DynamicResource TextTertiaryBrush}"/>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button Classes="seg" Classes.active="{Binding IsEasy}" Content="Easy" Command="{Binding SetEasyCommand}"/>
                <Button Classes="seg" Classes.active="{Binding IsNormal}" Content="Normal" Command="{Binding SetNormalCommand}"/>
                <Button Classes="seg" Classes.active="{Binding IsChallenge}" Content="Challenge" Command="{Binding SetChallengeCommand}"/>
            </StackPanel>

            <TextBlock Text="Time to guess" FontSize="13" FontWeight="600" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextTertiaryBrush}"/>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button Classes="seg" Classes.active="{Binding IsTime5}" Content="5s" Command="{Binding SetTimeCommand}" CommandParameter="5"/>
                <Button Classes="seg" Classes.active="{Binding IsTime10}" Content="10s" Command="{Binding SetTimeCommand}" CommandParameter="10"/>
                <Button Classes="seg" Classes.active="{Binding IsTime15}" Content="15s" Command="{Binding SetTimeCommand}" CommandParameter="15"/>
                <Button Classes="seg" Classes.active="{Binding IsTime30}" Content="30s" Command="{Binding SetTimeCommand}" CommandParameter="30"/>
            </StackPanel>

            <CheckBox Content="Ramp difficulty up as the session goes" IsChecked="{Binding Progressive}"
                      HorizontalAlignment="Center" FontSize="12"/>
            <CheckBox Content="Preload whole session (no waiting between rounds — bigger download up front)"
                      IsChecked="{Binding Preload}" HorizontalAlignment="Center" FontSize="12"/>

            <TextBlock Text="How many rounds?" FontSize="13" FontWeight="600" HorizontalAlignment="Center"
                       Margin="0,4,0,0" Foreground="{DynamicResource TextTertiaryBrush}"/>
            <ItemsControl ItemsSource="{Binding RoundOptions}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Classes="count" Content="{Binding}"
                                Command="{Binding $parent[ItemsControl].DataContext.StartCommand}" CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="accent" Content="⚡  Quick Start  (10 rounds)" HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center" Padding="26,12" FontSize="15" Command="{Binding QuickStartCommand}"/>
            <TextBlock Text="Tip: press 1–4 to pick, Enter for the next round." FontSize="11"
                       HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"/>
            <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,6" Opacity="0.5"/>
            <Button Classes="ghost" Content="🏆  OP Battle Royale — pick your favourite" HorizontalAlignment="Center"
                    Padding="20,10" Command="{Binding OpenBattleCommand}"/>
        </StackPanel>
        </ScrollViewer>

        <!-- ============ PREPARING (preload) ============ -->
        <StackPanel IsVisible="{Binding IsPreparing}" Spacing="16" MaxWidth="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="⏳  Preloading the session" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding PreloadStatus}" FontSize="13" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding PreloadProgress}" Height="10" Width="360"
                         Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="Downloading every clip up front so there's no waiting mid-session."
                       FontSize="11" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"
                       HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"/>
            <Button Classes="ghost" Content="Cancel" HorizontalAlignment="Center" Padding="18,8"
                    Command="{Binding CancelPreloadCommand}"/>
        </StackPanel>

        <!-- ============ PLAYING ============ -->
        <Grid IsVisible="{Binding IsPlaying}" RowDefinitions="Auto,Auto,*,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <StackPanel Grid.Column="0" Spacing="1">
                    <TextBlock Text="{Binding ProgressLine}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding StreakLine}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ScoreLine}" FontSize="15" FontWeight="600" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Button Classes="ghost" Content="Quit" Padding="12,6" Command="{Binding QuitCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Countdown (guessing only) -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,10" IsVisible="{Binding IsGuessing}">
                <ProgressBar Grid.Column="0" Height="8" Minimum="0" Maximum="100" Value="{Binding TimeProgress}"
                             VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}">
                    <Run Text="{Binding RemainingSeconds}"/><Run Text="s"/>
                </TextBlock>
            </Grid>

            <!-- Media -->
            <Border Grid.Row="2" CornerRadius="12" ClipToBounds="True" Background="#000000" MinHeight="220">
                <Panel>
                    <controls:VideoPlayerControl x:Name="Player"/>
                    <!-- Guessing = audio only → show a listening card -->
                    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding IsGuessing}">
                        <TextBlock Text="🎵" FontSize="54" HorizontalAlignment="Center"/>
                        <TextBlock Text="What anime is this opening from?" FontSize="15" FontWeight="600"
                                   HorizontalAlignment="Center" Foreground="#E0E0E0"/>
                    </StackPanel>
                    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoading}">
                        <TextBlock Text="⏳" FontSize="40" HorizontalAlignment="Center"/>
                        <ProgressBar IsIndeterminate="True" Width="200" Height="5"/>
                        <TextBlock Text="{Binding LoadStatus}" FontSize="14" FontWeight="600" HorizontalAlignment="Center" Foreground="#FFFFFF"/>
                        <TextBlock Text="fetching the opening from animethemes…" FontSize="11" HorizontalAlignment="Center" Foreground="#AAAAAA"/>
                    </StackPanel>
                    <StackPanel Spacing="12" MaxWidth="380" HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="#EEEEEE"/>
                        <Button Classes="accent" Content="Try again" HorizontalAlignment="Center" Command="{Binding NextCommand}"/>
                    </StackPanel>
                    <Button Classes="ghost" Content="⟲ Replay" Padding="10,5" FontSize="11"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Command="{Binding ReplayCommand}"/>
                </Panel>
            </Border>

            <!-- Options + controls -->
            <StackPanel Grid.Row="3" Margin="0,14,0,0" Spacing="8">
                <ItemsControl ItemsSource="{Binding Options}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:QuizOptionVm">
                            <Button Classes="opt" Classes.selected="{Binding IsSelected}"
                                    Classes.correct="{Binding IsCorrect}" Classes.wrong="{Binding IsWrong}"
                                    Content="{Binding Name}" Command="{Binding SelectCommand}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Guessing: lock-in / reveal early -->
                <Button Grid.Row="0" Classes="ghost" Content="Reveal answer" HorizontalAlignment="Center" Padding="20,8"
                        IsVisible="{Binding IsGuessing}" Command="{Binding RevealCommand}"/>

                <!-- Revealed: result + next -->
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasAnswered}" Margin="6,2,6,0">
                    <TextBlock Grid.Column="0" Text="{Binding ResultText}" VerticalAlignment="Center"
                               FontSize="14" FontWeight="600" TextWrapping="Wrap"
                               Foreground="{Binding ResultColor, Converter={x:Static converters:StringToBrushConverter.Instance}}"/>
                    <Button Grid.Column="1" Classes="accent" Content="{Binding NextLabel}" Padding="20,8" Command="{Binding NextCommand}"/>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- ============ SUMMARY ============ -->
        <StackPanel IsVisible="{Binding IsSummary}" Spacing="14" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="🏁  Session complete" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding SummaryLine}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="{Binding SummaryDetail}" FontSize="13" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,6,0,0">
                <Button Classes="accent" Content="Play again" Padding="22,10" Command="{Binding QuickStartCommand}"/>
                <Button Classes="ghost" Content="Change setup" Padding="18,10" Command="{Binding PlayAgainCommand}"/>
            </StackPanel>
        </StackPanel>
    </Panel>
</UserControl>
