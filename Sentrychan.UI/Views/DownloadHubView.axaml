<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sentrychan.UI.ViewModels"
             x:Class="Sentrychan.UI.Views.DownloadHubView"
             x:DataType="vm:DownloadHubViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="24" RowDefinitions="Auto,Auto,*">

        <!-- Header row -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Search" FontSize="28" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Left"
                       VerticalAlignment="Center"/>
            <Button Content="Change Download Method" Classes="ghost"
                    Command="{Binding ChangeDownloadMethodCommand}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
        </Grid>

        <!-- Search bar + tabs row -->
        <StackPanel Grid.Row="1" Spacing="12" Margin="0,0,0,16">
            <Grid ColumnDefinitions="*, Auto">
                <TextBox Grid.Column="0"
                         Text="{Binding SearchQuery}"
                         Watermark="Search releases (e.g. 'Frieren 1080p') — Enter to search"
                         FontSize="14" Padding="12"
                         CornerRadius="8 0 0 8"
                         KeyDown="SearchBox_KeyDown"
                         Name="SearchBox"/>
                <Button Grid.Column="1"
                        Command="{Binding SearchCommand}"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        CornerRadius="0 8 8 0"
                        Padding="24,12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource SearchRegular}" Width="14" Height="14"/>
                        <TextBlock Text="Search" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Tab selector strip -->
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="Trending"
                        Command="{Binding ShowTrendingCommand}"
                        Classes="ghost"
                        FontSize="13" FontWeight="SemiBold" Padding="12,6">
                    <Button.Styles>
                        <Style Selector="Button">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Style>
                        <Style Selector="Button[IsVisible=True]">
                            <Setter Property="Opacity" Value="1"/>
                        </Style>
                    </Button.Styles>
                </Button>
                <Button Content="Search Results"
                        Classes="ghost"
                        IsVisible="{Binding IsShowingResults}"
                        FontSize="13" FontWeight="SemiBold" Padding="12,6"
                        Opacity="1"/>
            </StackPanel>

            <!-- Library match banner -->
            <Border IsVisible="{Binding HasLibraryMatch}"
                    Background="{DynamicResource AccentSubtleBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource LibraryRegular}" Width="16" Height="16"
                                  Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding LibraryMatchTitle, StringFormat='In your library: {0}'}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Open series detail to fill missing episodes"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Go to Series →"
                            Command="{Binding FillGapsForMatchCommand}"
                            Classes="accent" FontSize="12" Padding="12,6"/>
                </Grid>
            </Border>

            <!-- Status / error line -->
            <TextBlock Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage.Length}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="12" FontStyle="Italic"/>
        </StackPanel>

        <!-- Main content area -->
        <Grid Grid.Row="2">

            <!-- Loading spinners -->
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSearching}"
                         VerticalAlignment="Top" Foreground="{DynamicResource AccentBrush}"/>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoadingTrending}"
                         VerticalAlignment="Top" Foreground="{DynamicResource AccentBrush}" Opacity="0.5"/>

            <!-- Trending panel -->
            <Border IsVisible="{Binding IsShowingTrending}"
                    Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="12"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}"
                            Padding="16,12" CornerRadius="12,12,0,0">
                        <Grid ColumnDefinitions="2*,1*,1*,1*,80">
                            <TextBlock Grid.Column="0" Text="TITLE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="SIZE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="2" Text="DATE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="3" Text="SEEDS/LEECHES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="4" Text="GET" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Empty trending state -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Spacing="10" Margin="0,60"
                                IsVisible="{Binding !TrendingResults.Count}">
                        <TextBlock Text="Loading trending..." FontSize="14"
                                   Foreground="{DynamicResource TextTertiaryBrush}" TextAlignment="Center"
                                   IsVisible="{Binding IsLoadingTrending}"/>
                        <TextBlock Text="No trending data available" FontSize="14"
                                   Foreground="{DynamicResource TextTertiaryBrush}" TextAlignment="Center"
                                   IsVisible="{Binding !IsLoadingTrending}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" IsVisible="{Binding TrendingResults.Count}">
                        <ItemsControl ItemsSource="{Binding TrendingResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReleaseResultRowVm">
                                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,11">
                                        <Grid ColumnDefinitions="2*,1*,1*,1*,80">
                                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border Background="#204CAF50" Padding="5,1" CornerRadius="4" IsVisible="{Binding IsTrusted}">
                                                        <TextBlock Text="TRUSTED" FontSize="9" FontWeight="Bold" Foreground="#4CAF50"/>
                                                    </Border>
                                                    <Border Background="{DynamicResource AccentSubtleBrush}" Padding="5,1" CornerRadius="4">
                                                        <TextBlock Text="{Binding ParsedQuality}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Size}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Date}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Seeders}" FontSize="13" Foreground="#4CAF50" FontWeight="SemiBold"/>
                                                <TextBlock Text="/" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding Leechers}" FontSize="13" Foreground="#F44336"/>
                                            </StackPanel>
                                            <Button Grid.Column="4"
                                                    Command="{Binding DownloadCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="ghost" Padding="8"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    IsEnabled="{Binding !IsDownloaded}"
                                                    ToolTip.Tip="Download">
                                                <PathIcon Data="{StaticResource DownloadRegular}" Width="16" Height="16"
                                                          Foreground="{DynamicResource AccentBrush}"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Search results panel -->
            <Border IsVisible="{Binding IsShowingResults}"
                    Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="12"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}"
                            Padding="16,12" CornerRadius="12,12,0,0"
                            IsVisible="{Binding SearchResults.Count}">
                        <Grid ColumnDefinitions="2*,1*,1*,1*,80">
                            <TextBlock Grid.Column="0" Text="TITLE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="SIZE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="2" Text="DATE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="3" Text="SEEDS/LEECHES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="4" Text="GET" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Empty state -->
                    <StackPanel Grid.Row="0" Grid.RowSpan="2"
                                IsVisible="{Binding !SearchResults.Count}"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Spacing="10" Margin="0,60">
                        <PathIcon Data="{StaticResource SearchIcon}" Width="36" Height="36"
                                  Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="No results found" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center"/>
                        <TextBlock Text="Try a different search term or check spelling"
                                   FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" IsVisible="{Binding SearchResults.Count}">
                        <ItemsControl ItemsSource="{Binding SearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReleaseResultRowVm">
                                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,11">
                                        <Grid ColumnDefinitions="2*,1*,1*,1*,80">
                                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border Background="#204CAF50" Padding="5,1" CornerRadius="4" IsVisible="{Binding IsTrusted}">
                                                        <TextBlock Text="TRUSTED" FontSize="9" FontWeight="Bold" Foreground="#4CAF50"/>
                                                    </Border>
                                                    <Border Background="{DynamicResource AccentSubtleBrush}" Padding="5,1" CornerRadius="4">
                                                        <TextBlock Text="{Binding ParsedQuality}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Size}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Date}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Seeders}" FontSize="13" Foreground="#4CAF50" FontWeight="SemiBold"/>
                                                <TextBlock Text="/" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding Leechers}" FontSize="13" Foreground="#F44336"/>
                                            </StackPanel>
                                            <Button Grid.Column="4"
                                                    Command="{Binding DownloadCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="ghost" Padding="8"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    IsEnabled="{Binding !IsDownloaded}"
                                                    ToolTip.Tip="Download">
                                                <PathIcon Data="{StaticResource DownloadRegular}" Width="16" Height="16"
                                                          Foreground="{DynamicResource AccentBrush}"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
