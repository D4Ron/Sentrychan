<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sentrychan.UI.ViewModels"
             xmlns:views="using:Sentrychan.UI.Views"
             xmlns:ctrls="using:Sentrychan.UI.Controls"
             xmlns:converters="using:Sentrychan.UI.Converters"
             xmlns:services="using:Sentrychan.UI.Services"
             x:Class="Sentrychan.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Resources>
        <converters:StringContainsConverter x:Key="StringContainsConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- ── Section row: title + description left, fields right, divider below ── -->
        <Style Selector="ctrls|SettingsSection">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                            Padding="0,26,0,28">
                        <Grid ColumnDefinitions="280,*" ColumnSpacing="40">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="{TemplateBinding Title}" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{TemplateBinding Description}" FontSize="13.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- ── Fields ── -->
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        </Style>
        <Style Selector="StackPanel.fields">
            <Setter Property="Spacing" Value="20"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Padding" Value="13,12"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- Outlined fields: transparent, a hairline border, the accent on focus. -->
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <Style Selector="ComboBox /template/ Border#Background">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}"/>
        </Style>
        <Style Selector="ComboBox:focus-visible /template/ Border#Background, ComboBox:dropdownopen /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.field">
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.pill">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="18,8"/>
        </Style>
        <Style Selector="TextBlock.status">
            <Setter Property="Foreground" Value="{DynamicResource StatusGreenBrush}"/>
        </Style>
        <Style Selector="TextBlock.status.error">
            <Setter Property="Foreground" Value="{DynamicResource StatusRedBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto">
        <ScrollViewer x:Name="PageScroll" Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="40,34,40,40" MaxWidth="1180" HorizontalAlignment="Stretch">

                <TextBlock Text="Settings" FontSize="32" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Manage your library, downloads, playback and app preferences"
                           FontSize="14" Margin="0,6,0,24"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <TabControl Classes="pills">

                    <!-- ═══════════════ General ═══════════════ -->
                    <TabItem Header="General">
                        <StackPanel Margin="0,12,0,0">
                            <ctrls:SettingsSection Title="Folders"
                                                   Description="Where downloads land, and the library they're organised into.">
                                <StackPanel Classes="fields">
                                    <StackPanel>
                                        <TextBlock Text="Download folder" Classes="label"/>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <TextBox Text="{Binding DownloadPath}" Watermark="C:\Downloads"/>
                                            <Button Grid.Column="1" Content="Browse" Classes="ghost field"
                                                    Command="{Binding BrowseDownloadCommand}"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Library folder" Classes="label"/>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <TextBox Text="{Binding LibraryPath}" Watermark="D:\Anime"/>
                                            <Button Grid.Column="1" Content="Browse" Classes="ghost field"
                                                    Command="{Binding BrowseLibraryCommand}"/>
                                        </Grid>
                                        <TextBlock Classes="hint" Text="Finished downloads are moved here, into Title / Season N folders."/>
                                    </StackPanel>
                                </StackPanel>
                            </ctrls:SettingsSection>

                            <ctrls:SettingsSection Title="Monitoring"
                                                   Description="How often your feeds are checked, and which quality to pick.">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                    <StackPanel>
                                        <TextBlock Text="Check every (minutes)" Classes="label"/>
                                        <TextBox Text="{Binding CheckInterval}" Watermark="15"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Preferred quality" Classes="label"/>
                                        <ComboBox ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding QualityPreference}"/>
                                    </StackPanel>
                                </Grid>
                            </ctrls:SettingsSection>

                            <ctrls:SettingsSection Title="Release groups"
                                                   Description="Which release wins when several groups put out the same episode.">
                                <StackPanel Classes="fields">
                                    <StackPanel>
                                        <TextBlock Text="Preferred groups" Classes="label"/>
                                        <TextBox Text="{Binding PreferredReleaseGroups}"
                                                 Watermark="GroupA, GroupB — highest priority first"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Auto-download only from" Classes="label"/>
                                        <TextBox Text="{Binding AutoDownloadGroups}" Watermark="Any group"/>
                                        <TextBlock Classes="hint"
                                                   Text="For series with auto-download on. Releases from other groups wait for your confirmation."/>
                                    </StackPanel>
                                </StackPanel>
                            </ctrls:SettingsSection>
                        </StackPanel>
                    </TabItem>

                    <!-- ═══════════════ Notifications ═══════════════ -->
                    <TabItem Header="Notifications">
                        <StackPanel Margin="0,12,0,0">
                            <ctrls:SettingsSection Title="When to notify"
                                                   Description="Choose how much Sentrychan tells you, and where.">
                                <StackPanel Classes="fields">
                                    <StackPanel>
                                        <TextBlock Text="Notify me about" Classes="label"/>
                                        <ComboBox ItemsSource="{Binding NotificationLevels}" SelectedItem="{Binding NotificationLevel}"
                                                  HorizontalAlignment="Left" MinWidth="260"/>
                                        <TextBlock Classes="hint"
                                                   Text="Off — nothing · Important — episodes, chapters and finished downloads · All — also routine check summaries."/>
                                    </StackPanel>
                                    <StackPanel>
                                        <ToggleSwitch IsChecked="{Binding WindowsNotifications}"
                                                      OnContent="Windows notifications" OffContent="Windows notifications"/>
                                        <TextBlock Classes="hint"
                                                   Text="On: important events pop up as Windows notifications. Off: they stay as quiet messages inside the app."/>
                                    </StackPanel>
                                </StackPanel>
                            </ctrls:SettingsSection>
                        </StackPanel>
                    </TabItem>

                    <!-- ═══════════════ Downloads ═══════════════ -->
                    <TabItem Header="Downloads">
                        <StackPanel Margin="0,12,0,0">
                            <ctrls:SettingsSection Title="Download engine"
                                                   Description="What fetches your downloads, and which files in the download folder get organised.">
                                <StackPanel Classes="fields">
                                    <StackPanel>
                                        <TextBlock Text="Active backend" Classes="label"/>
                                        <ComboBox ItemsSource="{Binding BackendOptions}" SelectedItem="{Binding SelectedDownloadBackend}"
                                                  HorizontalAlignment="Left" MinWidth="260"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <ToggleSwitch IsChecked="{Binding WatchFolderMode}"
                                                      OnContent="Watch-folder mode" OffContent="Watch-folder mode"/>
                                        <TextBlock Classes="hint"
                                                   Text="Off (default): only files Sentrychan downloaded, or that match a series in your library, are organised. On: every video in the download folder is filed — only if that folder is dedicated to anime."/>
                                    </StackPanel>
                                </StackPanel>
                            </ctrls:SettingsSection>

                            <ctrls:SettingsSection Title="Speed limits"
                                                   Description="Caps for the built-in torrent engine. Blank means unlimited; changes apply at once."
                                                   IsVisible="{Binding SelectedDownloadBackend, Converter={StaticResource StringContainsConverter}, ConverterParameter='MonoTorrent'}">
                                <StackPanel>
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                                        <StackPanel>
                                            <TextBlock Text="Download (KB/s)" Classes="label"/>
                                            <TextBox Text="{Binding MaxDownloadRate}" Watermark="Unlimited"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Upload (KB/s)" Classes="label"/>
                                            <TextBox Text="{Binding MaxUploadRate}" Watermark="Unlimited"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="At the same time" Classes="label"/>
                                            <TextBox Text="{Binding MaxConcurrentDownloads}" Watermark="Unlimited"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Classes="hint"
                                               Text="Extra downloads wait and start as slots free up. Leave some upload available — seeding keeps releases alive."/>
                                </StackPanel>
                            </ctrls:SettingsSection>

                            <ctrls:SettingsSection Title="qBittorrent"
                                                   Description="Connection to your qBittorrent Web UI."
                                                   IsVisible="{Binding SelectedDownloadBackend, Converter={StaticResource StringContainsConverter}, ConverterParameter='QBittorrent'}">
                                <StackPanel Classes="fields">
                                    <StackPanel>
                                        <TextBlock Text="Web UI address" Classes="label"/>
                                        <TextBox Text="{Binding QBitUrl}" Watermark="http://localhost:8080"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                        <StackPanel>
                                            <TextBlock Text="Username" Classes="label"/>
                                            <TextBox Text="{Binding QBitUsername}" Watermark="admin"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Password" Classes="label"/>
                                            <TextBox Text="{Binding QBitPassword}" PasswordChar="●"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button Content="Test connection" Classes="ghost pill" Command="{Binding TestQBitConnectionCommand}"/>
                                        <TextBlock Text="{Binding QBitTestResult}" VerticalAlignment="Center" FontSize="13"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ctrls:SettingsSection>

                            <ctrls:SettingsSection Title="Free Download Manager"
                                                   Description="Downloads are handed to FDM."
                                                   IsVisible="{Binding SelectedDownloadBackend, Converter={StaticResource StringContainsConverter}, ConverterParameter='SystemDefault'}">
                                <StackPanel>
                                    <TextBlock Text="FDM executable" Classes="label"/>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBox Text="{Binding FdmPath}"/>
                                        <Button Grid.Column="1" Content="Browse" Classes="ghost field" Command="{Binding BrowseFdmCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </ctrls:SettingsSection>

                            <ctrls:SettingsSection Title="Monitored feeds"
                                                   Description="The RSS feeds checked for new episodes. Only enabled feeds are monitored.">
                                <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10"
                                        IsVisible="{Binding RssFeedsVm, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <views:RssFeedsView DataContext="{Binding RssFeedsVm}"/>
                                </Border>
                            </ctrls:SettingsSection>
                        </StackPanel>
                    </TabItem>

                    <!-- ═══════════════ Playback ═══════════════ -->
                    <TabItem Header="Playback">
                        <StackPanel Margin="0,12,0,0">
                            <ctrls:SettingsSection Title="Video player"
                                                   Description="What plays your episodes. Internal is the built-in player; the vault always uses it.">
                                <StackPanel Classes="fields">
                                    <StackPanel>
                                        <TextBlock Text="Preferred player" Classes="label"/>
                                        <ComboBox ItemsSource="{Binding PlayerOptions}" SelectedItem="{Binding SelectedPlayer}"
                                                  HorizontalAlignment="Left" MinWidth="260"/>
                                    </StackPanel>
                                    <StackPanel IsVisible="{Binding SelectedPlayer, Converter={StaticResource StringContainsConverter}, ConverterParameter='VLC'}">
                                        <TextBlock Text="VLC executable" Classes="label"/>
                                        <TextBox Text="{Binding VlcPath}" Watermark="C:\Program Files\VideoLAN\VLC\vlc.exe"/>
                                    </StackPanel>
                                </StackPanel>
                            </ctrls:SettingsSection>
                        </StackPanel>
                    </TabItem>

                    <!-- ═══════════════ Library ═══════════════ -->
                    <TabItem Header="Library">
                        <StackPanel Margin="0,12,0,0">
                            <ctrls:SettingsSection Title="MyAnimeList import"
                                                   Description="Add everything on your MAL watching list to the library.">
                                <StackPanel Classes="fields">
                                    <StackPanel>
                                        <TextBlock Text="MAL username" Classes="label"/>
                                        <TextBox Text="{Binding MalUsername}" Watermark="username" MaxWidth="420" HorizontalAlignment="Left" MinWidth="320"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button Content="Import watching list" Classes="ghost pill" Command="{Binding ImportMalWatchingCommand}"/>
                                        <TextBlock Text="{Binding MalImportResult}" VerticalAlignment="Center" FontSize="13"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ctrls:SettingsSection>

                            <ctrls:SettingsSection Title="Backup"
                                                   Description="Save your library, feeds and settings to a file, or restore them.">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Export library…" Classes="ghost pill" Command="{Binding ExportLibraryCommand}"/>
                                    <Button Content="Import library…" Classes="ghost pill" Command="{Binding ImportLibraryCommand}"/>
                                </StackPanel>
                            </ctrls:SettingsSection>

                            <ctrls:SettingsSection Title="Tidying up"
                                                   Description="Keep the library to what you're still following.">
                                <StackPanel>
                                    <ToggleSwitch IsChecked="{Binding AutoRemoveCompleted}"
                                                  OnContent="Remove finished series automatically" OffContent="Remove finished series automatically"/>
                                    <TextBlock Classes="hint"
                                               Text="Once a series has finished airing and every episode is downloaded, its library entry is removed. Your files are never touched."/>
                                </StackPanel>
                            </ctrls:SettingsSection>

                            <ctrls:SettingsSection Title="Local manga"
                                                   Description="Read manga you already have on disk with the Local source.">
                                <StackPanel>
                                    <TextBlock Text="Manga folder" Classes="label"/>
                                    <TextBox Text="{Binding LocalMangaPath}" Watermark="D:\Manga"/>
                                    <TextBlock Classes="hint"
                                               Text="Each subfolder is a manga; its chapter subfolders hold the page images — the same layout downloaded chapters use."/>
                                </StackPanel>
                            </ctrls:SettingsSection>

                            <ctrls:SettingsSection Title="Source packs"
                                                   Description="Sentrychan ships with no online sources. Packs add them and load on the next start.">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Import source pack…" Classes="ghost pill" Command="{Binding ImportSourcePackCommand}"/>
                                    <Button Content="Open sources folder" Classes="ghost pill" Command="{Binding OpenSourcesFolderCommand}"/>
                                </StackPanel>
                            </ctrls:SettingsSection>

                            <ctrls:SettingsSection Title="Danger zone"
                                                   Description="Erase the library database: series, history and settings. Your files stay on disk.">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Reset library database" Classes="ghost pill" IsVisible="{Binding !ConfirmingReset}"
                                            Foreground="{DynamicResource StatusRedBrush}" BorderBrush="{DynamicResource StatusRedBrush}"
                                            Command="{Binding ResetLibraryCommand}"/>
                                    <Button Content="Yes, erase everything" Classes="pill" IsVisible="{Binding ConfirmingReset}"
                                            Background="{DynamicResource StatusRedBrush}" Foreground="White"
                                            Command="{Binding ResetLibraryCommand}"/>
                                    <Button Content="Keep my library" Classes="ghost pill" IsVisible="{Binding ConfirmingReset}"
                                            Command="{Binding CancelResetCommand}"/>
                                </StackPanel>
                            </ctrls:SettingsSection>
                        </StackPanel>
                    </TabItem>

                    <!-- ═══════════════ Appearance ═══════════════ -->
                    <TabItem Header="Appearance">
                        <StackPanel Margin="0,12,0,0">
                            <ctrls:SettingsSection Title="Theme &amp; layout"
                                                   Description="Changes preview immediately; Save keeps them, Discard puts them back.">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                    <StackPanel>
                                        <TextBlock Text="Theme" Classes="label"/>
                                        <ComboBox SelectedItem="{Binding SelectedTheme}">
                                            <x:String>Yoru</x:String>
                                            <x:String>Shiro</x:String>
                                            <x:String>Sakura</x:String>
                                            <x:String>Neon</x:String>
                                        </ComboBox>
                                        <TextBlock Classes="hint" Text="Yoru — dark violet · Shiro — light · Sakura — pink · Neon — cyber green"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Navigation" Classes="label"/>
                                        <ComboBox ItemsSource="{Binding LayoutOptions}" SelectedItem="{Binding LayoutMode}"/>
                                        <TextBlock Classes="hint" Text="Sidebar — left rail · Top Bar — horizontal navigation"/>
                                    </StackPanel>
                                </Grid>
                            </ctrls:SettingsSection>

                            <ctrls:SettingsSection Title="Background"
                                                   Description="A blurred image behind the library.">
                                <StackPanel>
                                    <TextBlock Text="Background image" Classes="label"/>
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                        <TextBox Text="{Binding BackgroundImagePath}" Watermark="None" IsReadOnly="True"/>
                                        <Button Grid.Column="1" Content="Browse" Classes="ghost field" Command="{Binding BrowseBackgroundImageCommand}"/>
                                        <Button Grid.Column="2" Content="Clear" Classes="ghost field" Command="{Binding ClearBackgroundImageCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </ctrls:SettingsSection>
                        </StackPanel>
                    </TabItem>

                    <!-- ═══════════════ Account ═══════════════ -->
                    <TabItem Header="Account">
                        <StackPanel Margin="0,12,0,0">
                            <ctrls:SettingsSection Title="Cloud account"
                                                   Description="Optional. Syncs your library across devices and powers friends and watch parties.">
                                <StackPanel Classes="fields">
                                    <TextBlock FontSize="13.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Everything else works without an account — your library, downloads and reader stay on this PC."/>
                                    <Button Content="Manage account…" Classes="accent pill" HorizontalAlignment="Left"
                                            Command="{Binding OpenAccountCommand}"/>
                                </StackPanel>
                            </ctrls:SettingsSection>
                        </StackPanel>
                    </TabItem>

                    <!-- ═══════════════ About ═══════════════ -->
                    <TabItem Header="About">
                        <StackPanel Margin="0,12,0,0">
                            <ctrls:SettingsSection Title="Sentrychan"
                                                   Description="Your self-driving library for anime, manga and novels.">
                                <StackPanel Classes="fields">
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <Border Width="64" Height="64" CornerRadius="32" ClipToBounds="True"
                                                Background="{DynamicResource CardBackgroundBrush}">
                                            <Image Source="avares://Sentrychan.UI/Assets/logo.png" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="Sentrychan" FontSize="20" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding AppVersion}" FontSize="13"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Content="Check for updates" Classes="ghost pill"
                                                Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding !IsCheckingUpdate}"/>
                                        <Button Content="Download &amp; restart" Classes="accent pill"
                                                Command="{Binding ApplyUpdateCommand}" IsVisible="{Binding UpdateAvailable}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding UpdateStatus}" FontSize="13" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </ctrls:SettingsSection>

                            <ctrls:SettingsSection Title="Community" Description="Questions, bug reports and what's coming next.">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Join the Discord" Classes="accent pill" Command="{Binding OpenLinkCommand}"
                                            CommandParameter="{x:Static services:AppLinks.Discord}"/>
                                    <Button Content="Website" Classes="ghost pill" Command="{Binding OpenLinkCommand}"
                                            CommandParameter="{x:Static services:AppLinks.Website}"/>
                                    <Button Content="Report a bug" Classes="ghost pill" Command="{Binding OpenLinkCommand}"
                                            CommandParameter="{x:Static services:AppLinks.Issues}"/>
                                </StackPanel>
                            </ctrls:SettingsSection>

                            <ctrls:SettingsSection Title="Help" Description="Walkthrough and diagnostics.">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Show tutorial" Classes="ghost pill" Command="{Binding ShowTutorialCommand}"/>
                                    <Button Content="Open logs folder" Classes="ghost pill" Command="{Binding OpenLogsCommand}"/>
                                </StackPanel>
                            </ctrls:SettingsSection>

                            <TextBlock Margin="0,20,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Text="Made by D4Ron. Uses Jikan (MyAnimeList), AnitomySharp and the anime-offline-database."/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Save bar: only while there's something to save or report. A page has no
             Cancel button, so unsaved edits wait here — and survive leaving the page. -->
        <Border Grid.Row="1" IsVisible="{Binding ShowSaveBar}"
                Background="{DynamicResource SurfaceBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                Padding="40,14">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" MaxWidth="1180">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="You have unsaved changes" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                               IsVisible="{Binding IsDirty}"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" TextWrapping="Wrap"
                               Classes="status" Classes.error="{Binding IsStatusError}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Discard" Classes="ghost pill"
                        Command="{Binding DiscardCommand}" IsVisible="{Binding IsDirty}"/>
                <Button Grid.Column="2" Content="Save changes" Classes="accent pill"
                        Command="{Binding SaveCommand}" IsVisible="{Binding IsDirty}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
