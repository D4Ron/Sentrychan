<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        SECRET MODE THEME (Sentrykun)
        Deep purple/crimson palette — distinct from the normal dark theme.
        All SM_ keys mirror the standard keys but with overridden values.
    -->

    <!-- Background layers -->
    <Color x:Key="SM_AppBackground">#0D0A14</Color>
    <Color x:Key="SM_SurfaceBackground">#160D20</Color>
    <Color x:Key="SM_CardBackground">#1C1128</Color>
    <Color x:Key="SM_SidebarBackground">#110B1A</Color>

    <!-- Accent — deep crimson/purple -->
    <Color x:Key="SM_Accent">#8B2FC9</Color>
    <Color x:Key="SM_AccentLight">#B060E8</Color>
    <Color x:Key="SM_AccentSubtle">#2A1340</Color>
    <Color x:Key="SM_AccentHover">#9B3FD9</Color>

    <!-- Text -->
    <Color x:Key="SM_TextPrimary">#F0E8FF</Color>
    <Color x:Key="SM_TextSecondary">#B89FD8</Color>
    <Color x:Key="SM_TextMuted">#6B5085</Color>
    <Color x:Key="SM_TextTertiary">#4A3366</Color>

    <!-- Borders -->
    <Color x:Key="SM_BorderSubtle">#2D1F40</Color>
    <Color x:Key="SM_BorderDefault">#3D2955</Color>

    <!-- Status (same semantics, adjusted hues) -->
    <Color x:Key="SM_StatusGreen">#2DD4B0</Color>
    <Color x:Key="SM_StatusRed">#E040A0</Color>
    <Color x:Key="SM_StatusYellow">#C9A028</Color>

    <!-- Brushes (reference the colors above) -->
    <SolidColorBrush x:Key="AppBackgroundBrush"    Color="{StaticResource SM_AppBackground}"/>
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="{StaticResource SM_SurfaceBackground}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush"   Color="{StaticResource SM_CardBackground}"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SM_SidebarBackground}"/>
    <SolidColorBrush x:Key="AccentBrush"           Color="{StaticResource SM_Accent}"/>
    <SolidColorBrush x:Key="AccentLightBrush"      Color="{StaticResource SM_AccentLight}"/>
    <SolidColorBrush x:Key="AccentSubtleBrush"     Color="{StaticResource SM_AccentSubtle}"/>
    <SolidColorBrush x:Key="AccentHoverBrush"      Color="{StaticResource SM_AccentHover}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"      Color="{StaticResource SM_TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"    Color="{StaticResource SM_TextSecondary}"/>
    <SolidColorBrush x:Key="TextMutedBrush"        Color="{StaticResource SM_TextMuted}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush"     Color="{StaticResource SM_TextTertiary}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush"     Color="{StaticResource SM_BorderSubtle}"/>
    <SolidColorBrush x:Key="BorderDefaultBrush"    Color="{StaticResource SM_BorderDefault}"/>
    <SolidColorBrush x:Key="StatusGreenBrush"      Color="{StaticResource SM_StatusGreen}"/>
    <SolidColorBrush x:Key="StatusRedBrush"        Color="{StaticResource SM_StatusRed}"/>
    <SolidColorBrush x:Key="StatusYellowBrush"     Color="{StaticResource SM_StatusYellow}"/>

</ResourceDictionary>
